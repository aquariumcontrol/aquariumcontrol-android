digraph ScheduleModuleAndroid {
    node [shape=box, fontname="Helvetica"];
    rankdir=TB;
    compound=true;

    // --- Tier 1: Android UI Layer (Jetpack Compose) ---
    subgraph cluster_AndroidUI {
        label = "Android Presentation Layer (Compose)";
        style = dashed;
        color = blue;

        ScheduleScreen [label="ScheduleScreen\n(Main Hub)"];
        
        subgraph cluster_Composables {
            label = "UI Components";
            style = dotted;
            AdjustmentRow [label="ScheduleAdjustmentComposable"];
            ActionButtons [label="ScheduleUpdateResetButtonsComposable"];
        }
    }

    // --- Tier 2: Android ViewModel Layer ---
    subgraph cluster_AndroidViewModels {
        label = "ViewModel Layer (Lifecycle)";
        style = dashed;
        color = green;

        ScheduleViewModel [label="ScheduleViewModel\n(State: ScheduleUiState)"];
    }

    // --- Tier 3: Shared KMP Domain Layer ---
    subgraph cluster_SharedDomain {
        label = "Shared Domain Layer (Kotlin KMP)";
        style = dashed;
        color = orange;

        ScheduleRepository [label="<<interface>>\nScheduleRepository"];
        
        ScheduleType [label="<<enum>>\nScheduleType\n(Actuators)"];
        ScheduleData [label="<<entity>>\nScheduleData\n(Time Rule)"];
        ScheduleEntries [label="<<collection>>\nScheduleEntries"];
    }

    // --- Tier 4: Shared KMP Data Layer ---
    subgraph cluster_SharedData {
        label = "Shared Data Layer (Ktor)";
        style = dashed;
        color = red;

        ScheduleRepositoryImpl [label="ScheduleRepositoryImpl"];
        ScheduleApiService [label="<<interface>>\nScheduleApiService"];
        ScheduleEntryReader [label="ScheduleEntryReader\n(Parser)"];
    }

    // Relationships: UI to ViewModel
    ScheduleScreen -> ScheduleViewModel [label="observes"];
    ScheduleScreen -> {AdjustmentRow ActionButtons} [label="uses"];

    // Relationships: ViewModel to Repository
    ScheduleViewModel -> ScheduleRepository [label="calls"];

    // Relationships: Repository Implementations
    ScheduleRepositoryImpl -> ScheduleRepository [label="implements", style=dotted];

    // Relationships: Data Sources
    ScheduleRepositoryImpl -> ScheduleApiService [label="fetches from"];
    ScheduleRepositoryImpl -> ScheduleEntryReader [label="uses"];

    // Relationships: Models
    ScheduleRepository -> ScheduleEntries [label="exposes"];
    ScheduleEntries -> ScheduleData [label="contains"];
    ScheduleData -> ScheduleType [label="categorized by"];
}
