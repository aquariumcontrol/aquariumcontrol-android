digraph SummaryModuleAndroid {
    node [shape=box, fontname="Helvetica"];
    rankdir=TB;
    compound=true;

    // --- Tier 1: Android UI Layer (Jetpack Compose) ---
    subgraph cluster_AndroidUI {
        label = "Android Presentation Layer (Compose)";
        style = dashed;
        color = blue;

        SummaryScreen [label="SummaryScreen\n(Home Overview)"];
        
        subgraph cluster_Composables {
            label = "UI Components";
            style = dotted;
            SummaryTimestampComp [label="SummaryTimestampComposable"];
            SummaryActuatorsComp [label="SummaryActuatorsComposable"];
            SummaryWaterSignalsComp [label="SummaryWaterSignalsComposable"];
            SummaryAmbientComp [label="SummaryAmbientComposable"];
            SummaryControllerComp [label="SummaryControllerComposable"];
        }
    }

    // --- Tier 2: Android ViewModel Layer ---
    subgraph cluster_AndroidViewModels {
        label = "ViewModel Layer (Lifecycle)";
        style = dashed;
        color = green;

        SummaryViewModel [label="SummaryViewModel\n(State: SummaryUiState)"];
    }

    // --- Tier 3: Shared KMP Domain Layer ---
    subgraph cluster_SharedDomain {
        label = "Shared Domain Layer (Kotlin KMP)";
        style = dashed;
        color = orange;

        SummaryRepository [label="<<interface>>\nSummaryRepository"];
        SummaryData [label="<<entity>>\nSummaryData\n(Sensor & Actuator State)"];
    }

    // --- Tier 4: Shared KMP Data Layer ---
    subgraph cluster_SharedData {
        label = "Shared Data Layer (Ktor)";
        style = dashed;
        color = red;

        SummaryRepositoryImpl [label="SummaryRepositoryImpl"];
        SummaryDataApiService [label="<<interface>>\nSummaryDataApiService"];
        SummaryDataReader [label="SummaryDataReader\n(Parser)"];
    }

    // Relationships: UI to ViewModel
    SummaryScreen -> SummaryViewModel [label="observes"];
    SummaryScreen -> {
        SummaryTimestampComp 
        SummaryActuatorsComp 
        SummaryWaterSignalsComp 
        SummaryAmbientComp 
        SummaryControllerComp
    } [label="uses"];

    // Relationships: ViewModel to Repository
    SummaryViewModel -> SummaryRepository [label="calls"];

    // Relationships: Repository Implementations
    SummaryRepositoryImpl -> SummaryRepository [label="implements", style=dotted];

    // Relationships: Data Sources
    SummaryRepositoryImpl -> SummaryDataApiService [label="fetches from"];
    SummaryRepositoryImpl -> SummaryDataReader [label="uses"];

    // Relationships: Models
    SummaryRepository -> SummaryData [label="exposes"];
}
